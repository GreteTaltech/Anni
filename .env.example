# PostgreSQL connection string. On Railway this is injected automatically
# when the Postgres service is linked (Variables -> DATABASE_URL reference).
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Password for the researcher dashboard (/researcher). Required.
RESEARCHER_PASSWORD="change-me"

# Secret used to sign the researcher session cookie. Optional; a random
# value is recommended in production (e.g. `openssl rand -hex 32`).
AUTH_SECRET=""

# Anthropic API key for AI-assisted ranking (Group B). Optional: without it
# the app falls back to deterministic rule-based ranking and says so in the UI.
ANTHROPIC_API_KEY=""
# Claude model used for ranking. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL="claude-opus-5-5"
